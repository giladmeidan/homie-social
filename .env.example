# Copy to .env (which git ignores) and fill in. Used only by the scripts on your Mac.

# The Worker's address, printed by `npm run deploy`
HOMIE_SOCIAL_URL=https://homie-social.YOUR-SUBDOMAIN.workers.dev

# Same value you gave `wrangler secret put ADMIN_TOKEN`
ADMIN_TOKEN=

# Lets `--reel 44` find the caption by reel number
CAPTIONS_LOG=/Users/giladmeidan/rent_app/rent-app/homie/marketing/captions-log.md

# Only needed for `npm run telegram:webhook`
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
